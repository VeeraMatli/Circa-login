{
  "name": "anvaya",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "services/*",
    "apps/admin",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "dev": "npm run dev -w @anvaya/api",
    "dev:admin": "npm run dev -w @anvaya/admin",
    "db:migrate": "npm run db:migrate -w @anvaya/api",
    "db:seed": "npm run db:seed -w @anvaya/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:integration": "python3 tests/integration/workflow.py",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run lint && npm run typecheck && npm test && npm run contract:check && python3 scripts/check-schema.py",
    "setup": "npm ci && npm run db:migrate",
    "contract:check": "python3 scripts/check-contract.py",
    "lint": "eslint .",
    "contract:generate": "python3 scripts/generate-contract.py && openapi-typescript packages/api-contract/openapi.json -o packages/shared-types/src/api.generated.ts",
    "test:admin": "playwright test",
    "local": "node scripts/dev.mjs",
    "check:swift": "bash scripts/check-swift.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.13.0",
    "jsonc-parser": "^3.3.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^3.2.4"
  }
}
