# This file is documentation; no credentials are included. See docs/operations/providers.md.
API_BASE_URL=http://127.0.0.1:8787
ADMIN_PUBLIC_ORIGIN=http://127.0.0.1:3000
# Local admin bypass only with a loopback server AND Worker LOCAL_MODE=true.
ANVAYA_LOCAL_ADMIN=true
# Production: false. Never deploy the development Wrangler configuration.
LOCAL_MODE=true
APPLE_BUNDLE_ID=com.anvaya.dating
# Cloudflare Workers Secrets (securely provision values; do not paste into source):
# EMAIL_API_KEY, EMAIL_FROM, SMS_ACCOUNT, SMS_TOKEN, SMS_FROM
# ACCESS_TEAM, ACCESS_AUDIENCE, ADMIN_ROLES
# AGE_JWKS_URL, AGE_ISSUER, AGE_AUDIENCE
# MEDIA_PROCESSOR_URL, MEDIA_PROCESSOR_TOKEN, MODERATION_URL, MODERATION_TOKEN
# APNS_KEY, APNS_KEY_ID, APNS_TEAM_ID
# PURCHASE_VERIFIER_URL, PURCHASE_VERIFIER_TOKEN
# Node Apple verifier: VERIFIER_AUTH_TOKEN, APPLE_ENVIRONMENT, APPLE_BUNDLE_ID,
# APPLE_ROOT_CERT_PATHS, APPLE_PRIVATE_KEY_PATH, APPLE_KEY_ID, APPLE_ISSUER_ID,
# APPLE_APP_ID (production numeric app ID).
